        "north": "true"
      },
      "apply": {
        "model": "shmetro:block/iron_frame_bar"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "shmetro:block/iron_frame_bar",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "shmetro:block/iron_frame_bar",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "shmetro:block/iron_frame_bar",
        "y": 270
      }
    }
  ]
}